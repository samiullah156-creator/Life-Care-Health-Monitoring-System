rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated users can read/write; users can only access their own folder
    match /avatars/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /recipes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /health-tips/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /appointments/{appointmentId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /doctors/{doctorId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == doctorId;
    }
  }
}
